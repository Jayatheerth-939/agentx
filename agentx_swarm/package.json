{
  "name": "PhantomPatch-vscode",
  "displayName": "PhantomPatch Background Security Linter",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
